APP_ENV=development
DATABASE_URL=postgresql+psycopg://open_gaz:local-dev-password@localhost:5432/open_gaz
ADMIN_API_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=10080
REPORT_MAX_AGE_MINUTES=90
REPORT_MIN_CONFIDENCE=0.55
REPORT_RADIUS_METERS=1500
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STATION_VERIFY_THRESHOLD=3
STATION_HIDE_THRESHOLD=3
STATION_VOTE_RADIUS_METERS=500
MAX_NEW_STATIONS_PER_DAY=5
MAX_COMMENTS_PER_10_MIN=5
